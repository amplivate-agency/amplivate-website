---
---

<div class="cookie-consent" id="cookie-consent" role="dialog" aria-live="polite" aria-label="Cookie notice" hidden>
  <div class="cookie-consent__inner">
    <p class="cookie-consent__text">
      We use only essential cookies to run this site. No tracking or advertising cookies are
      set. See our <a href="/privacy">Privacy Policy</a> for details.
    </p>
    <div class="cookie-consent__actions">
      <button type="button" class="button button--primary" id="cookie-consent-accept">Got it</button>
    </div>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 100;
    background: var(--color-charcoal);
    color: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift);
    padding: 1.25rem 1.5rem;
  }

  .cookie-consent__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    max-width: 1100px;
    margin-inline: auto;
  }

  .cookie-consent__text {
    flex: 1 1 320px;
    font-size: var(--step-sm);
    color: var(--color-white);
    margin: 0;
  }

  .cookie-consent__text a {
    color: var(--color-white);
    text-decoration: underline;
  }

  .cookie-consent__actions {
    flex-shrink: 0;
  }

  @media (min-width: 600px) {
    .cookie-consent {
      left: 1.5rem;
      bottom: 1.5rem;
      max-width: 640px;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'cookie-consent-ack';
  const banner = document.getElementById('cookie-consent');
  const acceptButton = document.getElementById('cookie-consent-accept');

  if (banner && !localStorage.getItem(STORAGE_KEY)) {
    banner.hidden = false;
  }

  acceptButton?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, '1');
    if (banner) banner.hidden = true;
  });
</script>
