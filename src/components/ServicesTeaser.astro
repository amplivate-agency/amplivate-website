---
import { getCollection } from 'astro:content';
import home from '../data/home.json';

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const groupOrder = ['Visibility & Marketing', 'AI Solutions'];
const groups = groupOrder.map((label) => ({
  label,
  items: allServices.filter((s) => s.data.group === label),
}));
---

<section class="services">
  <div class="container">
    <div class="services__header">
      <span class="eyebrow">{home.services.eyebrow}</span>
      <h2 class="services__heading">{home.services.heading}</h2>
    </div>

    <div class="services__groups">
      {groups.map((group) => (
        <div class="services__group">
          <p class="services__group-label">{group.label}</p>
          <ul class="services__list">
            {group.items.map((item, i) => (
              <li>
                <a href={`/services/${item.id}`} class="services__item">{item.data.title}</a>
                {i < group.items.length - 1 && <span class="services__dot" aria-hidden="true">&middot;</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <a href="/services" class="services__more">See full details on Services &rarr;</a>
  </div>
</section>

<style>
  .services {
    padding-block: var(--section-padding);
  }

  .services__header {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .services__heading {
    font-size: var(--step-2xl);
    font-weight: 600;
  }

  .services__groups {
    display: grid;
    gap: 3rem;
  }

  .services__group-label {
    font-size: var(--step-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-strong);
    margin-bottom: 1.25rem;
  }

  .services__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
  }

  .services__list li {
    display: flex;
    align-items: baseline;
  }

  .services__item {
    font-family: var(--font-heading);
    font-size: var(--step-lg);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
    transition: color 0.3s var(--ease-out);
  }

  .services__item:hover {
    color: var(--color-accent-strong);
  }

  .services__dot {
    color: var(--color-silver);
    margin-inline: 0.6rem;
    font-size: var(--step-lg);
  }

  .services__more {
    display: block;
    text-align: center;
    margin-top: 3rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-charcoal);
    border-bottom: 1px solid var(--color-charcoal);
    padding-bottom: 2px;
    width: fit-content;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .services__groups {
      grid-template-columns: repeat(2, 1fr);
      gap: 4rem;
    }
  }
</style>
