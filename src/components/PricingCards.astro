---
// Each tier's `features` is the full cumulative list for that plan (what a
// client editing this in Decap actually thinks in terms of — "what does
// Growth include" — not an incremental diff). The "Everything in X, plus:"
// framing and the trimmed per-card list are derived here from that single
// source of truth, so there's nothing redundant to keep in sync by hand.
interface Tier {
  name: string;
  price: string;
  priceNote: string;
  tagline: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
}

interface Props {
  tiers: Tier[];
}

const { tiers } = Astro.props;
const countClass = ['', 'one', 'two', 'three'][Math.min(tiers.length, 3)];

const cards = tiers.map((tier, i) => {
  const previous = i > 0 ? tiers[i - 1] : null;
  const displayFeatures = previous
    ? tier.features.filter((f) => !previous.features.includes(f))
    : tier.features;
  const intro = previous ? `Everything in ${previous.name}, plus:` : undefined;
  return { ...tier, displayFeatures, intro };
});
---

<div class={`pricing-cards pricing-cards--${countClass}`} id="pricing-cards">
  {cards.map((tier) => (
    <div class="pricing-cards__card">
      <p class="pricing-cards__name">{tier.name}</p>
      <p class="pricing-cards__price">
        {tier.price}
        <span class="pricing-cards__price-note">{tier.priceNote}</span>
      </p>
      <p class="pricing-cards__tagline">{tier.tagline}</p>
      {tier.intro && <p class="pricing-cards__intro">{tier.intro}</p>}
      <ul class="pricing-cards__features">
        {tier.displayFeatures.map((feature) => (
          <li>
            <svg class="pricing-cards__tick" width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M5 13l4.5 4.5L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {feature}
          </li>
        ))}
      </ul>
      <div class="pricing-cards__cta">
        <a href={tier.ctaHref} class="button button--primary">{tier.ctaLabel}</a>
      </div>
    </div>
  ))}
</div>

<style>
  .pricing-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 440px;
    margin-inline: auto;
  }

  .pricing-cards--two {
    max-width: 780px;
  }

  .pricing-cards--three {
    max-width: none;
  }

  @media (min-width: 900px) {
    .pricing-cards--two {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }

    .pricing-cards--three {
      grid-template-columns: repeat(3, 1fr);
      perspective: 1400px;
    }
  }

  .pricing-cards__card {
    display: flex;
    flex-direction: column;
    text-align: left;
    background: var(--color-white);
    border: 1px solid var(--color-light-grey);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-soft);
    position: relative;
    z-index: 1;
  }

  .pricing-cards--three .pricing-cards__card:nth-child(2) {
    border: 2px solid #c9a227;
  }

  @media (min-width: 900px) {
    .pricing-cards__card {
      transition:
        transform 0.6s var(--ease-out),
        box-shadow 0.6s var(--ease-out);
    }

    .pricing-cards--three.is-scrolled .pricing-cards__card:first-child {
      transform: translateX(28px) scale(0.95) rotateY(-6deg);
    }

    .pricing-cards--three.is-scrolled .pricing-cards__card:last-child {
      transform: translateX(-28px) scale(0.95) rotateY(6deg);
    }

    .pricing-cards--three.is-scrolled .pricing-cards__card:not(:first-child):not(:last-child) {
      transform: scale(1.05);
      z-index: 2;
      box-shadow: var(--shadow-lift);
    }

    .pricing-cards--two.is-scrolled .pricing-cards__card:first-child {
      transform: translateX(16px) scale(0.97);
    }

    .pricing-cards--two.is-scrolled .pricing-cards__card:last-child {
      transform: translateX(-16px) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-cards__card {
      transition: none !important;
      transform: none !important;
    }
  }

  .pricing-cards__name {
    font-size: var(--step-sm);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-strong);
    margin: 0 0 1.25rem;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--color-light-grey);
  }

  .pricing-cards__price {
    font-family: var(--font-heading);
    font-size: var(--step-lg);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-charcoal);
    margin: 0 0 0.5rem;
  }

  .pricing-cards__price-note {
    display: inline-block;
    margin-left: 0.4rem;
    font-family: var(--font-body);
    font-size: var(--step-sm);
    font-weight: 400;
    color: var(--color-slate-blue);
  }

  .pricing-cards__tagline {
    color: var(--color-slate-blue);
    margin-bottom: 1.5rem;
  }

  .pricing-cards__intro {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .pricing-cards__features {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    flex: 1;
  }

  .pricing-cards__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-light-grey);
    font-size: var(--step-sm);
  }

  .pricing-cards__features li:last-child {
    border-bottom: none;
  }

  .pricing-cards__tick {
    flex-shrink: 0;
    color: var(--color-accent);
    margin-top: 2px;
  }

  .pricing-cards__cta .button {
    width: 100%;
  }
</style>

<script>
  const containers = document.querySelectorAll<HTMLElement>('.pricing-cards');
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle('is-scrolled', entry.isIntersecting);
      }
    },
    { threshold: 0.4 },
  );
  containers.forEach((el) => io.observe(el));
</script>
