---
import home from '../data/home.json';
const points = home.trust.points;
---

<section class="trust">
  <div class="container">
    <div class="trust__grid">
      {points.map((point, i) => (
        <div class="trust__item" style={`--i: ${i}`} data-reveal>
          <span class="trust__ghost" aria-hidden="true">{point.ghost}</span>
          <h3 class="trust__heading">{point.heading}</h3>
          <p class="trust__text">{point.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: var(--section-padding);
    background: var(--color-bg-subtle);
  }

  .trust__grid {
    display: grid;
    gap: 1.5rem;
  }

  .trust__item {
    position: relative;
    overflow: hidden;
    background: var(--color-white);
    border: 1px solid var(--color-silver);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    padding-top: 6rem;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.7s var(--ease-out),
      border-color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
    transition-delay: calc(var(--i) * 90ms), calc(var(--i) * 90ms), 0s, 0s;
  }

  .trust__item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .trust__item.is-visible:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lift);
    transform: translateY(-6px);
  }

  .trust__item:hover .trust__ghost {
    color: var(--color-silver);
  }

  .trust__ghost {
    position: absolute;
    top: 0.5rem;
    left: 1.25rem;
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 6vw, 3.75rem);
    font-weight: 600;
    color: var(--color-light-grey);
    line-height: 1;
    user-select: none;
    z-index: 0;
    transition: color 0.35s var(--ease-out);
  }

  .trust__heading {
    position: relative;
    z-index: 1;
    font-size: var(--step-lg);
    margin-bottom: 0.75rem;
  }

  .trust__text {
    position: relative;
    z-index: 1;
    color: var(--color-slate-blue);
  }

  @media (min-width: 700px) {
    .trust__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Progressive enhancement: where scroll-driven animations are supported,
     let each card drift at a slightly different rate as it crosses the
     viewport instead of relying only on the one-time reveal above. */
  @supports (animation-timeline: view()) {
    .trust__item {
      animation: trust-parallax linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 40%;
    }

    .trust__item:nth-child(even) {
      animation-duration: 1.2s;
    }
  }

  @keyframes trust-parallax {
    from {
      transform: translateY(calc(20px + var(--i) * 6px));
    }
    to {
      transform: translateY(0);
    }
  }
</style>

<script>
  const items = document.querySelectorAll('[data-reveal]');
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.2 },
  );
  items.forEach((item) => io.observe(item));
</script>
